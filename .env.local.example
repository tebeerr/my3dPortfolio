# ── SMTP Configuration (Contact Form) ─────────────────────────────────────────
# For Gmail: use smtp.gmail.com with an App Password (not your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
#
# For other providers, use their SMTP host/port (e.g. smtp.mail.yahoo.com:587).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teberramzi@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Where contact emails land (defaults to teberramzi@gmail.com if unset)
CONTACT_TO=teberramzi@gmail.com
